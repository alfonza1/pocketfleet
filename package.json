{
  "name": "@alfonza1/pocketfleet",
  "version": "0.2.0",
  "description": "A private job fleet for the computers you already own.",
  "type": "module",
  "bin": {
    "pocketfleet": "src/cli.mjs"
  },
  "files": [
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node src/cli.mjs serve --init",
    "start": "node src/cli.mjs serve",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "build": "node scripts/check.mjs",
    "test:e2e": "node scripts/browser-check.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfonza1/pocketfleet.git"
  },
  "keywords": [
    "agents",
    "local-ai",
    "distributed",
    "homelab",
    "job-queue"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
